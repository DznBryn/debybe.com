{
  "name": "@debybe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages/graphql/src --import tsx ./src/index.ts",
    "start": "tsx src/index.ts",
